# MERA 本地部署环境变量
# 使用方式: cp .env.example .env 后按需修改

# ────────── PostgreSQL ──────────
POSTGRES_PASSWORD=mera_local_pass

# ────────── Casdoor OIDC ──────────
# 首次启动 Casdoor 后，在 http://localhost:8000 管理后台创建 mera Application，
# 将 Client ID / Client Secret 填回这里并 docker compose restart backend-app worker-1 worker-2 beat
CASDOOR_CLIENT_ID=
CASDOOR_CLIENT_SECRET=

# ────────── 邮件通知（抓取完成 WebSocket + 邮件中的邮件通道）──────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@mera.local
