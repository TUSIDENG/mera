# MERA 本地部署环境变量
# 使用方式: cp .env.example .env 后按需修改

# ────────── PostgreSQL ──────────
POSTGRES_PASSWORD=mera_local_pass

# ────────── Casdoor OIDC ──────────
# 首次启动 Casdoor 后，在 http://localhost:8000 管理后台创建 mera Application，
# 将 Client ID / Client Secret 填回这里并 docker compose restart backend-app worker-1 worker-2 beat
CASDOOR_CLIENT_ID=
CASDOOR_CLIENT_SECRET=
# 浏览器端访问 Casdoor 的地址（前端容器启动时写入 /config.js，供登录跳转使用）
CASDOOR_BROWSER_ENDPOINT=http://localhost:8000

# ────────── 内部服务鉴权 ──────────
# 后端内部接口令牌（worker/beat 内部调用校验），留空表示不校验
INTERNAL_API_TOKEN=

# ────────── 容器出网 / 系统代理 ──────────
# 容器内所有出网流量先经宿主机 Clash（默认日本节点）；不需要代理时把这几项留空
HTTP_PROXY=http://host.docker.internal:6789
HTTPS_PROXY=http://host.docker.internal:6789
# 本地服务与容器互联走直连，不走 Clash
NO_PROXY=localhost,127.0.0.1,postgres,redis,casdoor

# ────────── 采集代理（M06）──────────
# 采集请求使用的代理。留空则各服务用 compose 内置默认值：
#   backend-app / worker-1 / beat → http://host.docker.internal:6789（Clash）
#   worker-2                      → http://127.0.0.1:9999（容器内 1024proxy 中继）
# 注意：在此显式赋值会同时覆盖 worker-2 的中继默认值，一般保持注释即可
# MERA_FETCH_PROXY=

# 1024proxy 中继出站路由开关（worker-2 内手动启动的中继进程读取）
# 1 = 两跳：Clash → 1024proxy 住宅出口（中国大陆部署，来源 IP 需靠 Clash 加白）
# 0 = 单跳：直连 1024proxy endpoint（服务器部署在日本/新加坡且该 IP 已加白名单）
MERA_RELAY_HOP1=1
MERA_RELAY_CLASH_HOST=host.docker.internal
MERA_RELAY_CLASH_PORT=6789
# 1024proxy 白名单凭证 user:pass（中继向 1024proxy 取住宅出口时使用），必填
MERA_RELAY_ENDPOINT_CRED=

# ────────── 邮件通知（抓取完成 WebSocket + 邮件中的邮件通道）──────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@mera.local

# ────────── LLM 离线打分（采集成功后大模型按采集数据打分，无 key 视为关闭）──────────
LLM_SCORER_ENABLED=false
# 打分模型提供方：deepseek / gemini / chatgpt / openrouter
LLM_SCORER_PROVIDER=deepseek
# 缺省用注册表默认模型（如 deepseek-chat），可按需覆盖
LLM_SCORER_MODEL=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
CHATGPT_API_KEY=
# 兼具 OpenRouter 采集源可选提额与打分模型两种用途
OPENROUTER_API_KEY=
